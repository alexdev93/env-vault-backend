{
  "info": {
    "name": "env-vault API",
    "description": "env-vault Worker API. Authenticated requests use the collection-level Bearer token ({{apiToken}}); the dashboard itself uses the session cookie from Login instead.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{apiToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Dashboard (root)",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "url": "{{baseUrl}}/"
      }
    },
    {
      "name": "Login",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"password\": \"{{dashboardPassword}}\" }"
        },
        "url": "{{baseUrl}}/api/login"
      }
    },
    {
      "name": "Who am I",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/whoami"
      }
    },
    {
      "name": "List variables",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/vars",
        "description": "Names and metadata only ({key, type, projects, updated_at, shared}). Use Get variable value for a value."
      }
    },
    {
      "name": "Get variable value",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/vars/DATABASE_URL/value",
        "description": "Returns {value} for one variable. The dashboard calls this per reveal or copy."
      }
    },
    {
      "name": "List projects",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/projects"
      }
    },
    {
      "name": "Project env (what envvault calls)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/projects/{{project}}/env"
      }
    },
    {
      "name": "Project env for a branch",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/projects/{{project}}/env?branch=main",
        "description": "Defaults with the branch's overrides on top. 404 if the branch doesn't exist."
      }
    },
    {
      "name": "Get variable",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/vars/DATABASE_URL"
      }
    },
    {
      "name": "Edit variable",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/vars/DATABASE_URL",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"notes\": \"Neon main database\"\n}"
        },
        "description": "Any of key (rename), value, notes, projects."
      }
    },
    {
      "name": "Create project with details",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/projects",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"my-api\",\n  \"description\": \"API server\",\n  \"notes\": \"Deploys on push to main\",\n  \"repo_url\": \"https://github.com/me/my-api\",\n  \"site_url\": \"https://my-api.example.com\",\n  \"services\": [\n    {\n      \"kind\": \"database\",\n      \"provider\": \"neon\",\n      \"url\": \"https://console.neon.tech\",\n      \"account\": \"me@gmail.com\"\n    },\n    {\n      \"kind\": \"hosting\",\n      \"provider\": \"cloudflare\",\n      \"url\": \"https://dash.cloudflare.com\",\n      \"account\": \"me@gmail.com\"\n    }\n  ],\n  \"branches\": [\n    \"main\",\n    {\n      \"name\": \"staging\",\n      \"notes\": \"preview\"\n    }\n  ]\n}"
        }
      }
    },
    {
      "name": "Get project",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/projects/{{project}}",
        "description": "By id or name: details, services, branches with their variable names."
      }
    },
    {
      "name": "Edit project",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/projects/{{project}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"notes\": \"updated notes\"\n}"
        }
      }
    },
    {
      "name": "Delete project",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/projects/{{project}}"
      }
    },
    {
      "name": "Add service",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/projects/{{project}}/services",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"kind\": \"email\",\n  \"provider\": \"resend\",\n  \"account\": \"me@gmail.com\"\n}"
        }
      }
    },
    {
      "name": "Edit service",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/services/{{serviceId}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"notes\": \"free tier\"\n}"
        }
      }
    },
    {
      "name": "Delete service",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/services/{{serviceId}}"
      }
    },
    {
      "name": "Add branch",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/projects/{{project}}/branches",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"main\",\n  \"notes\": \"production\"\n}"
        }
      }
    },
    {
      "name": "Get branch",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/branches/{{branchId}}"
      }
    },
    {
      "name": "Edit branch",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/branches/{{branchId}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"production\"\n}"
        }
      }
    },
    {
      "name": "Delete branch",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/branches/{{branchId}}"
      }
    },
    {
      "name": "Set branch variable",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/branches/{{branchId}}/vars",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"key\": \"DATABASE_URL\",\n  \"value\": \"postgres://...\",\n  \"notes\": \"prod db\"\n}"
        }
      }
    },
    {
      "name": "Get branch variable value",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/branches/{{branchId}}/vars/DATABASE_URL/value"
      }
    },
    {
      "name": "Edit branch variable",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/branches/{{branchId}}/vars/DATABASE_URL",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"notes\": \"rotated 2026-09\"\n}"
        }
      }
    },
    {
      "name": "Delete branch variable",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/branches/{{branchId}}/vars/DATABASE_URL"
      }
    },
    {
      "name": "Value history",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/history?owner=var:DATABASE_URL",
        "description": "Last 5 replaced values (ids + dates). Owners: var:KEY, branch:BRANCH_ID:KEY, item:ITEM_ID."
      }
    },
    {
      "name": "History value",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/history/{{historyId}}/value"
      }
    },
    {
      "name": "Restore history value",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/history/{{historyId}}/restore",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      }
    },
    {
      "name": "List personal items",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/items"
      }
    },
    {
      "name": "Create login",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/items",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"login\",\n  \"title\": \"Neon console\",\n  \"url\": \"https://console.neon.tech\",\n  \"username\": \"me@gmail.com\",\n  \"value\": \"password\",\n  \"project_id\": null\n}"
        }
      }
    },
    {
      "name": "Get item value",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/items/{{itemId}}/value"
      }
    },
    {
      "name": "Edit item",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/items/{{itemId}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"notes\": \"2FA on the authenticator app\"\n}"
        }
      }
    },
    {
      "name": "Delete item",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/items/{{itemId}}"
      }
    }
  ]
}
